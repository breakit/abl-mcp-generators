"/* handler for com.acme.Customer.command.command.DeleteCustomerCommand — write side, goes through the business entity (its signatures are unchanged) */
class com.acme.Customer.command.handler.DeleteCustomerCommandHandler:

  /* note: updatedata/deletedata evaluate row-state, so the contract temp-table needs a before-table */
  { com/acme/Customer/contract/customer-contract.i }
  define variable l-be-o as com.acme.Customer.business.Customer no-undo.

  constructor public DeleteCustomerCommandHandler():
    l-be-o = new com.acme.Customer.business.Customer().
  end constructor.

  /* execute — delete: the row is created as unchanged, then deleted, so the entity sees row-deleted */
  method public com.acme.Customer.command.result.CustomerCommandResult execute(input i-command-o as com.acme.Customer.command.command.DeleteCustomerCommand):
    define variable l-result-o as com.acme.Customer.command.result.CustomerCommandResult no-undo.
    define variable l-ok-l     as logical no-undo.
    l-result-o = new com.acme.Customer.command.result.CustomerCommandResult().

    /* todo: authorization and business validation; on failure: l-result-o:addError("...") and return l-result-o. */

    empty temp-table l-customer-tt.
    temp-table l-customer-tt:tracking-changes = false.
    create l-customer-tt.
    l-customer-tt.CustNum = i-command-o:CustNum.
    dataset l-customer-ds:accept-changes().
    temp-table l-customer-tt:tracking-changes = true.
    delete l-customer-tt.

    l-ok-l = l-be-o:deletedata(input dataset l-customer-ds).

    if dataset l-customer-ds:error then
      l-result-o:collecterrors(dataset l-customer-ds:handle).
    else if not l-ok-l then
      l-result-o:addError("delete failed").

    return l-result-o.
  end method.

end class.
"
`;

