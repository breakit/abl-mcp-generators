"@openapi.openedge.export file (type="soap", executionmode="singleton").
class com.acme.Customer.controller.soap.CustomerController:

  /* soap controller for Customer — operations take and return datasets, no json */

  define variable l-service-o as com.acme.Customer.service.CustomerService no-undo.

  constructor public CustomerController():
    l-service-o = new com.acme.Customer.service.CustomerService().
  end constructor.

  /*
   * listall — return all records.
