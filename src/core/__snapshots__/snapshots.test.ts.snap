"/* handler for com.acme.Customer.command.command.ApproveCustomerCommand — custom command, delegates to the business task com.acme.Customer.task.ApproveCustomer */
class com.acme.Customer.command.handler.ApproveCustomerCommandHandler:

  /* input of the task: must match the dataset of the task class */
  define temp-table l-input-tt no-undo
    .
  define dataset l-input-ds for l-input-tt.
  /* output of the task: add the extra output fields of the task here */
  define temp-table l-output-tt no-undo
    field statuscode    as character
    field statusmessage as character.
  define dataset l-output-ds for l-output-tt.

  define variable l-task-o as com.acme.Customer.task.ApproveCustomer no-undo.

  constructor public ApproveCustomerCommandHandler():
    l-task-o = new com.acme.Customer.task.ApproveCustomer().
  end constructor.

  method public com.acme.Customer.command.result.CustomerCommandResult execute(input i-command-o as com.acme.Customer.command.command.ApproveCustomerCommand):
    define variable l-result-o as com.acme.Customer.command.result.CustomerCommandResult no-undo.
    define variable l-status-c as character no-undo.
    l-result-o = new com.acme.Customer.command.result.CustomerCommandResult().

    /* todo: authorization and business validation */

    empty temp-table l-input-tt.
    create l-input-tt.

    l-status-c = l-task-o:execute(input dataset l-input-ds, output dataset l-output-ds).
    if l-status-c <> "success" then do:
      find first l-output-tt no-error.
      l-result-o:addError(if available l-output-tt then l-output-tt.statusmessage else l-status-c).
    end.

    return l-result-o.
  end method.

end class.
"
`;

