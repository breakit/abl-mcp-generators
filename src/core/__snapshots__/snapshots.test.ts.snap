"@openapi.openedge.export file (type="rest", executionmode="singleton").
class com.acme.Customer.service.CustomerService:

  /* facade for Customer: dispatches to command and query handlers, contains no logic itself */

  define variable l-create-command-handler-o as com.acme.Customer.command.handler.CreateCustomerCommandHandler no-undo.
  define variable l-update-command-handler-o as com.acme.Customer.command.handler.UpdateCustomerCommandHandler no-undo.
  define variable l-delete-command-handler-o as com.acme.Customer.command.handler.DeleteCustomerCommandHandler no-undo.
  define variable l-getById-query-handler-o as com.acme.Customer.query.handler.GetByIdCustomerQueryHandler no-undo.
  define variable l-list-query-handler-o as com.acme.Customer.query.handler.ListCustomerQueryHandler no-undo.

  constructor public CustomerService():
    l-create-command-handler-o = new com.acme.Customer.command.handler.CreateCustomerCommandHandler().
    l-update-command-handler-o = new com.acme.Customer.command.handler.UpdateCustomerCommandHandler().
    l-delete-command-handler-o = new com.acme.Customer.command.handler.DeleteCustomerCommandHandler().
    l-getById-query-handler-o = new com.acme.Customer.query.handler.GetByIdCustomerQueryHandler().
    l-list-query-handler-o = new com.acme.Customer.query.handler.ListCustomerQueryHandler().
  end constructor.

  /* command: Create */
  method public com.acme.Customer.command.result.CustomerCommandResult create(input i-command-o as com.acme.Customer.command.command.CreateCustomerCommand):
    return l-create-command-handler-o:execute(i-command-o).
  end method.

  /* command: Update */
  method public com.acme.Customer.command.result.CustomerCommandResult update(input i-command-o as com.acme.Customer.command.command.UpdateCustomerCommand):
    return l-update-command-handler-o:execute(i-command-o).
  end method.

  /* command: Delete */
  method public com.acme.Customer.command.result.CustomerCommandResult delete(input i-command-o as com.acme.Customer.command.command.DeleteCustomerCommand):
    return l-delete-command-handler-o:execute(i-command-o).
  end method.

  /* query: GetById */
  method public handle getById(input i-query-o as com.acme.Customer.query.query.GetByIdCustomerQuery):
    return l-getById-query-handler-o:execute(i-query-o).
  end method.

  /* query: List */
  method public handle list(input i-query-o as com.acme.Customer.query.query.ListCustomerQuery):
    return l-list-query-handler-o:execute(i-query-o).
  end method.

end class.
"
`;

